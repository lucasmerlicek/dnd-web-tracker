# NextAuth
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Vercel KV (from Vercel dashboard after creating/connecting a KV store)
KV_REST_API_READ_ONLY_TOKEN="your-read-only-token-here"
KV_REST_API_TOKEN="your-rest-api-token-here"
KV_REST_API_URL="https://your-database.upstash.io"
KV_URL="rediss://default:your-token@your-database.upstash.io:6379"
KV_REDIS_URL="rediss://default:your-token@your-database.upstash.io:6379"
